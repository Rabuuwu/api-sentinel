DATABASE_URL=postgresql+asyncpg://sentinel:change-me@127.0.0.1:54329/sentinel
POSTGRES_PASSWORD=change-me
SENTINEL_API_KEY=replace-with-at-least-32-random-characters
CHECK_CONCURRENCY=10
MAX_MONITORS=100
RETENTION_DAYS=30
DISCORD_WEBHOOK_URL=
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SECRETS_DIR=.local/secrets
FRONTEND_DIR=frontend/dist
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8000
# Vite development proxy; browser requests remain same-origin.
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional external dashboard; exact origin, without /api-sentinel/ path.
# CORS_ORIGINS=https://rabuuwu.github.io
CORS_ORIGINS=

# Optional durable encrypted channel secrets; generate 32 random bytes as 64 hex chars.
# Keep the same key across Render restarts/deployments. Never put it in frontend variables.
WEBHOOK_ENCRYPTION_KEY=
WORKER_LOCK_WAIT_SECONDS=0
